{
  "name": "adpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A native, approval-gated advertising optimization agent.",
  "packageManager": "pnpm@10.30.3",
  "bin": {
    "adpilot": "dist/cli/index.js"
  },
  "scripts": {
    "adpilot": "tsx apps/cli/src/index.ts",
    "dev": "tsx watch apps/cli/src/index.ts serve",
    "build": "pnpm typecheck && tsup apps/cli/src/index.ts --format esm --platform node --out-dir dist/cli --banner.js '#!/usr/bin/env node' && vite build apps/desktop",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.4.0",
    "open": "^10.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.20.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
