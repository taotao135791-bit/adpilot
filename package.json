{
  "name": "adpilot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A native, approval-gated advertising optimization agent.",
  "author": "AdPilot Contributors",
  "files": [
    "dist/cli",
    "dist/desktop",
    "README.md",
    "LICENSE",
    "LICENSES.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses/**"
  ],
  "main": "dist/electron/main.js",
  "packageManager": "pnpm@10.30.3",
  "bin": {
    "adpilot": "dist/cli/index.js"
  },
  "scripts": {
    "adpilot": "pnpm build && node dist/cli/index.js",
    "capture:ui": "node scripts/capture-ui.mjs",
    "fixtures:visual": "node scripts/generate-visual-fixtures.mjs",
    "eval:gui": "node scripts/evaluate-visual-replay.mjs",
    "eval:computer-use:live": "tsx scripts/evaluate-computer-use-live.ts",
    "validate:google-ads:readonly": "tsx scripts/validate-google-ads.ts readonly",
    "validate:google-ads:prepare": "tsx scripts/validate-google-ads.ts prepare",
    "validate:visual:google-ads:observe": "tsx scripts/validate-google-ads.ts readonly",
    "validate:visual:google-ads:prepare": "tsx scripts/validate-google-ads.ts prepare",
    "icon:mac": "bash scripts/build-macos-icon.sh",
    "dev": "tsx watch apps/cli/src/index.ts serve",
    "build": "pnpm build:knowledge && pnpm typecheck && pnpm build:cli && pnpm build:desktop && pnpm build:electron && node scripts/postbuild.mjs",
    "build:knowledge": "node scripts/build-knowledge-data.mjs",
    "build:cli": "tsup apps/cli/src/index.ts --format esm --platform node --out-dir dist/cli",
    "build:desktop": "vite build",
    "build:electron": "tsup apps/electron/src/main.ts --format esm --platform node --out-dir dist/electron --external electron",
    "desktop": "pnpm build && env -u ELECTRON_RUN_AS_NODE electron dist/electron/main.js",
    "desktop:dir": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir",
    "desktop:dmg": "pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ads-core": "python3 -m pytest packages/advertising-core/python/tests/uac -q",
    "test:visual-replay": "vitest run evals/computer-use-replay/replay.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm test && pnpm test:ads-core && pnpm build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-ai": "0.80.10",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.2.0",
    "@ui-tars/action-parser": "1.2.3",
    "@ui-tars/operator-nut-js": "1.2.3",
    "@ui-tars/sdk": "1.2.3",
    "fastify": "^5.4.0",
    "jimp": "1.6.0",
    "open": "^10.2.0",
    "uuid": "11.1.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "playwright-core": "1.56.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "com.adpilot.desktop",
    "productName": "AdPilot",
    "asar": true,
    "forceCodeSigning": false,
    "asarUnpack": [
      "dist/desktop/**",
      "node_modules/**/*.node"
    ],
    "files": [
      "dist/electron/**",
      "dist/desktop/**",
      "package.json",
      "LICENSE",
      "LICENSES.md",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "artifactName": "AdPilot-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "AdPilot ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
