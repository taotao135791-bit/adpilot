{
  "name": "adpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A native, approval-gated advertising optimization agent.",
  "packageManager": "pnpm@10.30.3",
  "bin": {
    "adpilot": "dist/cli/index.js"
  },
  "scripts": {
    "adpilot": "pnpm build && node dist/cli/index.js",
    "capture:ui": "node scripts/capture-ui.mjs",
    "dev": "tsx watch apps/cli/src/index.ts serve",
    "build": "pnpm typecheck && tsup apps/cli/src/index.ts --format esm --platform node --out-dir dist/cli && vite build && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ads-core": "python3 -m pytest packages/advertising-core/python/tests/uac -q",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm test && pnpm test:ads-core && pnpm build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-ai": "0.80.10",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.2.0",
    "@fluentui/react-components": "9.74.4",
    "@fluentui/react-icons": "2.0.316",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@ui-tars/action-parser": "1.2.3",
    "@ui-tars/operator-nut-js": "1.2.3",
    "@ui-tars/sdk": "1.2.3",
    "fastify": "^5.4.0",
    "jimp": "1.6.0",
    "open": "^10.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "11.1.0",
    "yaml": "^2.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "playwright-core": "1.56.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
