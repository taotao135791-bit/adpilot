# Fast/default conversation and planning model
OPENAI_API_KEY=
ADPILOT_FAST_PROVIDER=openai
ADPILOT_FAST_MODEL=gpt-5-mini

# Strong reasoning escalation model
ADPILOT_STRONG_PROVIDER=openai
ADPILOT_STRONG_MODEL=gpt-5.2

# Optional dedicated GUI grounding. Leave blank to use image-capable Fast/Strong models.
ADPILOT_GUI_BASE_URL=
ADPILOT_GUI_API_KEY=
ADPILOT_GUI_MODEL=
ADPILOT_GUI_STRONG_MODEL=
ADPILOT_GUI_PROTOCOL=ui-tars
ADPILOT_GUI_IMAGE_INPUT=true
ADPILOT_GUI_COORDINATE_FORMAT=ui-tars-1000
ADPILOT_GUI_NORMALIZATION=window
ADPILOT_GUI_TIMEOUT_MS=20000
ADPILOT_GUI_MAX_RETRIES=2

# Optional independent verifier. VERIFY_MODE also accepts gui or strong.
ADPILOT_VERIFY_MODE=auto
ADPILOT_VERIFY_BASE_URL=
ADPILOT_VERIFY_API_KEY=
ADPILOT_VERIFY_MODEL=
ADPILOT_VERIFY_TIMEOUT_MS=20000

# HMAC secret used to bind one-time approval tokens. Use 32+ random bytes.
ADPILOT_APPROVAL_SECRET=
